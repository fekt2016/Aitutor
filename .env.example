# ── EazWorld AI Tutor — environment template ─────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Runtime config is read from env only (plan §2, §38).

# ── Database (MongoDB Atlas; plan §27, §33) ──────────────────────────────
# Create a free M0 cluster at cloud.mongodb.com → Database → Connect →
# "Drivers" connection string. Include the database name (e.g. eazworld).
# You may keep `<password>` in the URL and set DATABASE_PASSWORD separately,
# or paste a full URL — when DATABASE_PASSWORD is set it always wins over any
# password in the URL.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eazworld?retryWrites=true&w=majority
DATABASE_PASSWORD=

# ── Auth (plan §28) ──────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── App defaults (plan §30) ──────────────────────────────────────────────
# bcrypt cost (leave unset for default 12; lower only in tests)
BCRYPT_SALT_ROUNDS=12
# Messages per tutor session
SESSION_MSG_CAP=30
# Sessions per student per day
DAILY_SESSION_CAP=3
# Transcript retention in days (plan §19)
RETENTION_DAYS=30

# ── Phase 1+ (unused until those phases) ─────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL_TUTOR=gpt-4o-mini
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_STRUCTURED=gpt-4o-mini
# OPENAI_MODEL_SUMMARY=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=EazWorld AI Tutor <tutor@example.com>
# VERCEL_CRON_TOKEN=
# INNGEST_SIGNING_KEY=